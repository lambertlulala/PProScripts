
function copyFile(srcPath, dstPath)
    if (file.copy(srcPath, dstPath)) do
        *Message Successfully copy &(srcPath) to &(dstPath)
    else
        *Message Failed to copy &(srcPath) to ++ &(dstPath)
    endif
endfunction

function emptyRecyclebin()
    do("pwsh.exe", ?+-Command "Clear-RecycleBin -Force"+)
endfunction

function showRecyclebin()
    do("shell:RecycleBinFolder")
endfunction

function copyNewGUID()
    do("pwsh.exe", "-Command [guid]::NewGuid().toString() | clip")
endfunction

function convertToLinuxPath(path)
    local resultPath

    if (find(path, ?+\\wsl+) != -1) do
        local cvt = path.replacechars("\\", "/")
        local pos = 2
        cvt = slice(cvt, pos, length(cvt) - 1)
        for (local i = 0; i < 2; i++)
            pos = find(cvt, "/")
            if (pos != -1) do
                cvt = slice(cvt, pos + 1, length(cvt) - 1)
            endif
        endfor
        resultPath = "/" ++ cvt
    else
        local command = "wsl wslpath " ++ "\"" ++ path ++ "\""
        local tmpFile = env("TEMP") ++ "\\tmp_convert.txt"
        file.runwait(30000, "cmd.exe", "/c " ++ command ++ " > " ++ tmpFile, "", "hide")
        resultPath = file.readall(tmpFile)
        file.deletenorecycle(tmpFile)
    endif

    return(resultPath.removechars("\r\n"))
endfunction

function everythingSearchRedirectToTmpFile(searchPattern)
    local searchResult
    local tmpFile = env("TEMP") ++ "\\tmp_es_result.txt"
    file.runwait(60000, "es.exe", searchPattern ++ " -export-txt " ++ tmpFile, "", "hide")
    searchResult = file.readall(tmpFile)
    file.deletenorecycle(tmpFile)
    return(searchResult)
endfunction

function filterClipsWithES(text)
    local searchPattern = pprofolder ++ "clip\\*.powerproclip" ++ " utf16content:" ++ "\"" ++ text ++ "\""
    local results = everythingSearchRedirectToTmpFile(searchPattern)
    return(results)
endfunction

function searchClipTextWithES(clipFolder, clipFolderLen, inputTitle)
    local result = 0
    local textToSearch = input("Search clip text with ES")
    if (textToSearch) do
        local filteredResult = filterClipsWithES(textToSearch)
        local filteredCandidates
        for each line clip in filteredResult
            local item = remove(clip, clipFolderLen)
            local pos = revfind(item, ".PowerProClip")
            item = slice(item, pos)
            filteredCandidates = filteredCandidates ++ item ++ "\r"
        endfor

        setnextdialogpos(win.vscreenwidth / 2 - 400, win.vscreenheight / 2 - 200, 800, 400, "topmost")
        local pickedResult = pickstring(filteredCandidates, inputTitle, 2)
        if (pickedResult) do
            clip.load(clipFolder ++ pickedResult ++ ".PowerProClip")
            result = 1
        endif
    endif

    return(result)
endfunction

function searchClipTextWithPwsh(clipFolder, clipFolderLen, inputTitle)
    local result = 0
    local textToSearch = input("Search clip text with Pwsh")
    if (textToSearch) do
        local filteredResult = searchTextInAllClipFiles(textToSearch)
        local filteredCandidates
        for each line clip in filteredResult
            local item = remove(clip, clipFolderLen)
            local pos = revfind(item, ".PowerProClip")
            item = slice(item, pos)
            filteredCandidates = filteredCandidates ++ item ++ "\r"
        endfor

        setnextdialogpos(win.vscreenwidth / 2 - 400, win.vscreenheight / 2 - 200, 800, 400, "topmost")
        local pickedResult = pickstring(filteredCandidates, inputTitle, 2)
        if (pickedResult) do
            clip.load(clipFolder ++ pickedResult ++ ".PowerProClip")
            result = 1
        endif
    endif

    return(result)
endfunction

function searchFile(searchPattern)
    local searchResult
    local tmpFile = env("TEMP") ++ "\\tmp_search_result.txt"
    file.runwait(3600000, "cmd.exe", "/c dir /s/b/O-D " ++ "\"" ++ searchPattern ++ "\"" ++ " > " ++ tmpFile, "", "hide")
    searchResult = file.readall(tmpFile)
    file.deletenorecycle(tmpFile)
    return(ansitoutf8(searchResult))
endfunction

function listAllClipFiles(baseFolder)
    local searchResult
    local tmpFile = env("TEMP") ++ "\\tmp_search_result.txt"
    local folder = trim(baseFolder, "\\", 2)
    local cmd = "cd " ++ "\"" ++ folder ++ "\"" ++ " && Get-ChildItem -Recurse \"*.powerproclip\" | Sort-Object LastWriteTime -Descending | ForEach-Object { $_.FullName }"
    file.runwait(3600000, "pwsh.exe", "-Command " ++ cmd ++ " > " ++ tmpFile, "", "hide")
    searchResult = file.readall(tmpFile)
    file.deletenorecycle(tmpFile)
    return(searchResult)
endfunction

function searchTextInAllClipFiles(searchText)
    local searchResult
    local tmpFile = env("TEMP") ++ "\\tmp_search_text_result.txt"
    local baseFolder = pprofolder ++ "clip"
    local cmd = "cd " ++ "\"" ++ baseFolder ++ "\"" ++ " && Get-ChildItem -Recurse \"*.powerproclip\" | Select-String -Pattern " ++ "\"" ++ searchText ++ "\"" ++ " -Encoding \"utf-16\" | Select-Object -ExpandProperty Path"
    file.runwait(3600000, "pwsh.exe", "-Command " ++ cmd ++ " > " ++ tmpFile, "", "hide")
    searchResult = file.readall(tmpFile)
    file.deletenorecycle(tmpFile)
    return(searchResult)
endfunction

function searchAndPickResult(barName)
    local result
    for (local run = 1; run;)
        local searchPattern = input("Search")
        if (searchPattern) do
            if (cl.exists(barName)) do
                local hBar = cl.getBarHandle(barName)
                win.setfocus(hBar)
            endif

            local searchResult = everythingSearchRedirectToTmpFile(searchPattern)
            if (searchResult) do
                setnextdialogpos(win.vscreenwidth / 2 - 400, win.vscreenheight / 2 - 200, 800, 400, "topmost")
                result = pickstring(searchResult, "Pick Result", 2)
                if (result) do
                    run = 0
                endif
            endif
        else
            run = 0
        endif
    endfor

    return(result)
endfunction

function switchToWindow(barName, width, height)
    local inputTitle = "Switch to window (" ++ scriptname ++ ")"
    local showResult = .CustomEvent@showWindow(inputTitle)
    if (1 == showResult) do
        quit
    endif

    local wlist = window("visiblewindow", "*")
    local windowList
    // handles[i] is the window shown on line i+1 of the list (pickstring flag 2 = unsorted)
    local handles = vec.create(32, 16)
    for (local j = 1; ; j++)
        local handle = word(wlist, j)
        if (handle == "") do
            break
        endif

        local exStyle = win.getexstyle(handle)
        if ((exStyle & 0x080) && !(exStyle & 0x040000)) do
            continue
        endif

        // Skip windows hidden (cloaked) by Windows, e.g. TextInputHost.exe (Windows Input Experience)
        // and suspended UWP app windows. Note: windows on other Windows virtual desktops are cloaked too.
        if (win.getcloaked(handle) != 0) do
            continue
        endif

        local text = win.gettext(handle)
        if (text != "") do
            local fullPath = window("exefullpath", handle)
            handles[handles.length] = handle
            windowList = windowList ++ text ++ "    (" ++ fullPath ++ ")\r"
        endif
    endfor

    local x = win.vscreenwidth / 2 - width / 2
    local y = win.vscreenheight / 2 - height / 2
    setnextdialogpos(x, y, width, height, "topmost")

    local eventHandle = .CustomEvent@createShowWindowEvent(inputTitle, 50, 3)
    local sel = pickstring(windowList, inputTitle, 2)
    .CustomEvent@destroyShowWindowEvent(eventHandle)
    local switched = 0
    if (sel) do
        // _pickedline_ is the 1-based index of the picked line in the full (unfiltered) list
        local idx = _pickedline_ - 1
        if (idx >= 0 && idx < handles.length) do
            local h = handles[idx]
            // The window may have been closed while the dialog was open
            if (win.exists(h)) do
                window.show(h)
                switched = 1
            endif
        endif
    endif

    if (0 == switched) do
        win.resetfocus(15)
    endif
endfunction

function navigateToFolder(barName)
    local item = searchAndPickResult(barName)
    if (!item) do
        quit
    endif

    local folder
    item = trim(item, "\\", 2)
    if (file.isfolder(item)) do
        folder = item
    else
        local pos = revfind(item, "\\")
        if (pos != -1) do
            folder = slice(item, 0, pos - 1)
        endif
    endif

    *Keys {to *} ^l{w1}&(folder){enter}
endfunction

function insertDateTime()
    local oriDateTime = inputdatetime
    if (oriDateTime != "20010101010101") do
        local oriDate = slice(oriDateTime, 8)
        local newDate = formatdate("yyyy-MM-dd", oriDate)
        local oriTime = slice(oriDateTime, 8, 13)
        local newTime = formattime("HH:mm:ss", oriTime)
        local newDateTime = newDate ++ " " ++ newTime
        *Keys {to *}&(newDateTime)
    endif
endfunction

function runCommand(barName)
    local title = "Run command (" ++ scriptname ++ ")"
    local eventHandle = .CustomEvent@createShowWindowEvent(title, 50, 3)
    local pproCmdPrefix = ">"
    local cmd = input(title)
    .CustomEvent@destroyShowWindowEvent(eventHandle)
    if ("" != cmd) do
        local pproCmd = ""
        if (length(cmd) > 1) do
            local prefix = slice(cmd, 0, 0)
            if (pproCmdPrefix == prefix) do
                pproCmd = slice(cmd, 1, length(cmd) - 1)
            endif
        endif

        if ("" != pproCmd) do
            do(pproCmd)
        else
            local candidate
            if ("" != file.findexe("es.exe")) do
                local searchResult = everythingSearchRedirectToTmpFile(cmd)

                title = "Pick Result"
                eventHandle = .CustomEvent@createShowWindowEvent(title, 50, 3)
                setnextdialogpos(win.vscreenwidth / 2 - 400, win.vscreenheight / 2 - 200, 800, 400, "topmost")
                candidate = pickstring(searchResult, title, 2)
                .CustomEvent@destroyShowWindowEvent(eventHandle)
            else
                candidate = cmd
            endif

            if ("" != candidate) do
                local params
                title = "Parameters for " ++ candidate ++ " (" ++ scriptname ++ ")"
                eventHandle = .CustomEvent@createShowWindowEvent(title, 50, 3)
                local result = inputdialog("params=Parameters", title)
                .CustomEvent@destroyShowWindowEvent(eventHandle)
                if (result) do
                    do(candidate, params)
                endif
            endif
        endif
    endif

    win.resetfocus(15)
endfunction

function openWith(path)
    local title = "Open path with (" ++ scriptname ++ ")"
    local eventHandle = .CustomEvent@createShowWindowEvent(title, 50, 3)
    local executable = pickstring("Far Manager\rDouble Commander\rTerminal\rEmacs\r", title, 2)
    if (executable) do
        switch (_pickedline_)
            case 1
                do(?+C:\Program Files\Far Manager\Far.exe+, "\"" ++ path ++ "\"")
                break
            case 2
                do(?+C:\Program Files\Double Commander\doublecmd.exe+, "-L " ++ "\"" ++ path ++ "\"")
                break
            case 3
                do(?+"wt.exe"+, ?+new-tab -p "Command Prompt" -d+ ++ " " ++ "\"" ++ file.folder(path) ++ "\"")
                break
            case 4
                do(?+"C:\emacs\ucrt\nightly\bin\emacsclientw.exe"+, ?+-na ""+ ++ " " ++ "\"" ++ path ++ "\"")
                break
        endswitch
    endif
    .CustomEvent@destroyShowWindowEvent(eventHandle)
endfunction

// Launch an application, document, folder, or URL through the desktop Explorer.
function openAsUser(target, arguments, workFolder)
    if (target == "") do
        return("")
    endif

    local command = ?%-NoProfile -NonInteractive -STA -CommandWithArgs "(New-Object -ComObject Shell.Application).Windows().Item([uint32]8).Document.Application.ShellExecute($args[0].Substring(1), $args[1].Substring(1), $args[2].Substring(1), 'open', 1)"%
    // Prefix each value so pwsh treats it as a positional argument.
    command = command ++ " " ++ quoteWindowsArgument(":" ++ target) ++ " " ++ quoteWindowsArgument(":" ++ arguments) ++ " " ++ quoteWindowsArgument(":" ++ workFolder)
    do("pwsh.exe", command, "", "hidden")
endfunction

// Escape embedded quotes and double any backslashes immediately before a quote.
function quoteWindowsArgument(value)
    local quoted = replaceg(value, ?%([\\]*)"%, ?%\1\1\"%)
    quoted = replaceg(quoted, ?%(\\+)\z%, ?%\1\1%)
    return(?%"% ++ quoted ++ ?%"%)
endfunction
