
function _autoinit_()
    global CLIP_LIST_OPTION_ALL = 0
    global CLIP_LIST_OPTION_LIMITED = 1
    global CLIP_DEFAULT_CLIP_LIMIT_COUNT = 1000
endfunction

//==================== helpers ====================

function getDbPath()
    return(pprofolder ++ "pproclip.db")
endfunction

// Unique temp path prefix, so a capture that runs while the picker waits never collides with it.
function makeTempBase(tag)
    return(env("TEMP") ++ "\\pproclip_" ++ tag ++ "_" ++ Date.now ++ "_" ++ random(1000000))
endfunction

function deleteIfExists(path)
    if (path && file.validpath(path))
        file.deletenorecycle(path)
endfunction

// SQL string literal: quotes s and doubles any ' inside it.
function sqlStr(s)
    return("'" ++ replaceg(s, "'", "''") ++ "'")
endfunction

// LIKE pattern matching s anywhere; % _ ! typed by the user are taken literally.
function sqlLikeContains(s)
    local t = replaceg(s, "!", "!!")
    t = replaceg(t, "%", "!%")
    t = replaceg(t, "_", "!_")
    return(sqlStr("%" ++ t ++ "%") ++ " ESCAPE '!'")
endfunction

// Runs sql through a temp .sql file instead of the command line, so quotes, double quotes,
// newlines and non-ASCII text cannot break the command.
// outFile (optional): query results are written there in list mode.
// maxWait (optional): ms to wait for sqlite3; 0 or omitted = 1 hour.
// Returns 1 on success, 0 on any SQL error (-bail) or timeout.
// .timeout makes sqlite3 wait up to 3 s for a locked db instead of failing at once.
function runSql(sql, outFile, maxWait)
    if (!maxWait)
        maxWait = 3600000
    local sqlFile = makeTempBase("sql") ++ ".sql"
    local script = ""
    if (outFile)
        script = ".mode list\n.output '" ++ outFile ++ "'\n"
    file.writeall(sqlFile, script ++ sql ++ "\n")
    local cmd = "-bail -cmd \".timeout 3000\" \"" ++ getDbPath() ++ "\" \".read '" ++ sqlFile ++ "'\""
    local exitCode = file.runwait(maxWait, "sqlite3.exe", cmd, "", "hide")
    deleteIfExists(sqlFile)
    return(exitCode !== "" && exitCode == 0)
endfunction

// Lists clips for the picker. Returns a struct {lines, ids}:
//   lines: one "[TAGS: tags] first 256 chars on one line" per clip, for pickstring
//   ids:   vec where ids[i] is the ClipId shown on line i+1
// Both SELECTs run in one sqlite3 call inside one read transaction, so a clip captured
// meanwhile cannot shift the two outputs against each other (the capture waits via .timeout).
// The "[TAGS: ...]" prefix keeps every line non-empty, so line numbers always match ids.
function queryClipList(whereClause, tail)
    local base = makeTempBase("list")
    local idsFile = base ++ "_ids.txt"
    local linesFile = base ++ "_lines.txt"
    local preview = "substr(replace(replace(CAST(TextData AS TEXT), char(13), ' '), char(10), ' '), 1, 256)"
    local fromPart = " FROM Clipboard " ++ whereClause ++ " ORDER BY ClipId DESC" ++ tail ++ ";\n"
    local sql = "BEGIN;\n.mode list\n.output '" ++ idsFile ++ "'\nSELECT ClipId" ++ fromPart
    sql ++= ".output '" ++ linesFile ++ "'\nSELECT printf('[TAGS: %s] %s', ClipTags, " ++ preview ++ ")" ++ fromPart
    sql ++= ".output stdout\nCOMMIT;"
    local result = class.makestruct("lines ids")
    if (runSql(sql, "", 0) && file.validpath(idsFile) && file.validpath(linesFile)) do
        result.lines = file.readall(linesFile)
        result.ids = vec.createfromlines(file.readall(idsFile), 16)
    else
        result.lines = ""
        result.ids = vec.create(1, 16)
    endif
    deleteIfExists(idsFile)
    deleteIfExists(linesFile)
    return(result)
endfunction

// The copying program may still hold the clipboard open; clip.save then fails silently,
// so retry until the file exists. Returns 1 if saved.
function saveClipRetry(path)
    deleteIfExists(path)
    local saved = 0
    for (local i = 0; i < 5; i++)
        clip.save(path)
        saved = file.validpath(path)
        if (saved)
            break
        wait.for(50)
    endfor
    return(saved)
endfunction

// clip.get returns "" when the clipboard is busy, unlike clip.tofile which pops up
// "Cannot access text on clipboard clip to file" (its NoErr argument is ignored).
function getClipTextRetry()
    local text = ""
    for (local i = 0; i < 5; i++)
        text = clip.get
        if (text !== "")
            break
        wait.for(50)
    endfor
    return(text)
endfunction

// Puts a saved clip on the clipboard without ClipCapturing recording it again.
function loadClipNoCapture(path)
    if (!file.validpath(path))
        return(0)
    clip.ignorenext
    clip.load(path)
    return(1)
endfunction

//==================== capture ====================

function createClipInfoFiles()
    local clipInfo = class.makestruct("clipDataFile clipTextFile")
    local basePath = makeTempBase("cap")
    clipInfo.clipDataFile = basePath ++ ".powerproclip"
    clipInfo.clipTextFile = basePath ++ ".txt"

    saveClipRetry(clipInfo.clipDataFile)

    local text = "(non-text)"
    if (clip.HasFormat("TEXT") || clip.HasFormat("UNICODETEXT"))
        text = getClipTextRetry()
    file.writeall(clipInfo.clipTextFile, text)    // UTF-8, no BOM

    return(clipInfo)
endfunction

function deleteClipInfoFiles(clipInfo)
    deleteIfExists(clipInfo.clipDataFile)
    deleteIfExists(clipInfo.clipTextFile)
endfunction

function insertClipIntoDb(clipInfo)
    local sql = "INSERT INTO Clipboard(TextData, BinaryData) VALUES (CAST(readfile(" ++ sqlStr(clipInfo.clipTextFile) ++ ") AS TEXT), readfile(" ++ sqlStr(clipInfo.clipDataFile) ++ "));"
    return(runSql(sql, "", 30000))
endfunction

// Called from ClipCapturing. Returns 0 when the clip was stored in the db (PowerPro then
// skips its own history), 1 when storing failed so PowerPro keeps the clip in its history.
function onCapturingClip()
    local clipInfo = createClipInfoFiles()
    local stored = 0
    if (file.validpath(clipInfo.clipDataFile))
        stored = insertClipIntoDb(clipInfo)
    deleteClipInfoFiles(clipInfo)
    if (stored)
        return(0)
    win.debug("ClipCapturing: clip not stored in db; left to PowerPro history")
    return(1)
endfunction

//==================== database ====================

function createClipboardDbIfNonexistent()
    local sqlStatement = ?+CREATE TABLE IF NOT EXISTS "Clipboard" ("ClipId" INTEGER PRIMARY KEY AUTOINCREMENT, "TextData" TEXT NOT NULL, "BinaryData" BLOB NOT NULL, "CreatedAt" TEXT NOT NULL DEFAULT (DATETIME('now', 'localtime')), "ClipTags" TEXT);+
    runSql(sqlStatement, "", 0)
endfunction

function listClipsFromDb()
    return(queryClipList("", ""))
endfunction

function listLimitedNumberOfClipsFromDb(limitedCount)
    if (!isNumber(limitedCount) || limitedCount <= 0)
        limitedCount = CLIP_DEFAULT_CLIP_LIMIT_COUNT
    return(queryClipList("", " LIMIT " ++ limitedCount))
endfunction

function listAllClipsWithTagsFromDb()
    return(queryClipList("WHERE ClipTags IS NOT NULL AND ClipTags != ''", ""))
endfunction

function searchClipsInDb(text)
    return(queryClipList("WHERE TextData LIKE " ++ sqlLikeContains(text), ""))
endfunction

function searchClipsWithTagsInDb(tags)
    return(queryClipList("WHERE ClipTags LIKE " ++ sqlLikeContains(tags), ""))
endfunction

function createPProClipFileFromDb(clipId)
    local pproclipFile = env("TEMP") ++ "\\tmp_clip_from_db.powerproclip"
    deleteIfExists(pproclipFile)    // never hand back a stale clip if the row is gone
    runSql("SELECT writefile(" ++ sqlStr(pproclipFile) ++ ", BinaryData) FROM Clipboard WHERE ClipId = " ++ clipId ++ ";", "", 0)
    return(pproclipFile)
endfunction

// Writes the clip's stored text (UTF-8) to path without touching the clipboard.
function writeClipTextFromDb(clipId, path)
    deleteIfExists(path)
    runSql("SELECT writefile(" ++ sqlStr(path) ++ ", TextData) FROM Clipboard WHERE ClipId = " ++ clipId ++ ";", "", 0)
    return(file.validpath(path))
endfunction

function readClipTextFromDb(clipId)
    local path = makeTempBase("txt") ++ ".txt"
    local text = ""
    if (writeClipTextFromDb(clipId, path))
        text = file.readall(path)
    deleteIfExists(path)
    return(text)
endfunction

function updateClipInDb(clipId, utf8TextFile, pproClipFile)
    runSql("UPDATE Clipboard SET TextData = CAST(readfile(" ++ sqlStr(utf8TextFile) ++ ") AS TEXT), BinaryData = readfile(" ++ sqlStr(pproClipFile) ++ ") WHERE ClipId = " ++ clipId ++ ";", "", 0)
endfunction

function updateClipTagInDb(clipId, clipTags)
    runSql("UPDATE Clipboard SET ClipTags = " ++ sqlStr(clipTags) ++ " WHERE ClipId = " ++ clipId ++ ";", "", 0)
endfunction

function deleteClipInDb(clipId)
    runSql("DELETE FROM Clipboard WHERE ClipId = " ++ clipId ++ ";", "", 0)
endfunction

function deleteClipsWithoutTagsInDb()
    if (messagebox("yesno question" , "Delete the clips without tags?") != 6) do
        quit
    endif
    runSql("DELETE FROM Clipboard WHERE ClipTags IS NULL OR ClipTags = '';", "", 0)
endfunction

function deleteClipDb()
    if (messagebox("yesno question" , "Delete the clip database?") != 6) do
        quit
    endif
    file.deletenorecycle(getDbPath())
endfunction

function deleteAllClipsInDb()
    if (messagebox("yesno question" , "Delete all clips?") != 6) do
        quit
    endif
    runSql("DELETE FROM Clipboard; VACUUM;", "", 0)
endfunction

function keepLastClipsInDb(numClipsToKeep, withTags)
    if (!isNumber(numClipsToKeep) || numClipsToKeep <= 0) do
        win.debug("keepLastClipsInDb: invalid count ", numClipsToKeep)
        quit
    endif
    local sqlStatement
    if (withTags == 0) do
        sqlStatement = "DELETE FROM Clipboard WHERE ClipId NOT IN (SELECT ClipId FROM Clipboard ORDER BY ClipId DESC LIMIT " ++ numClipsToKeep ++ ");"
    else
        sqlStatement = "DELETE FROM Clipboard WHERE ClipId NOT IN (SELECT ClipId FROM Clipboard WHERE ClipTags IS NULL OR ClipTags = '' ORDER BY ClipId DESC LIMIT " ++ numClipsToKeep ++ ") AND (ClipTags IS NULL OR ClipTags = '');"
    endif
    runSql(sqlStatement, "", 0)
endfunction

//==================== picker ====================

function handleClipboardInDb(clipLimitCount)
    local inputTitle = "Select clipboard item (" ++ scriptname ++ ")"
    local showResult = .CustomEvent@showWindow(inputTitle)
    if (1 == showResult) do
        quit
    endif

    local candidates
    local clipActionInfo
    local clipCount
    if (!clipLimitCount || 0 == clipLimitCount) do
        clipCount = CLIP_DEFAULT_CLIP_LIMIT_COUNT
    else
        clipCount = clipLimitCount
    endif

    for (local run = 1; run;)
        if (clipActionInfo) do
            if (clipActionInfo.listOption == CLIP_LIST_OPTION_ALL) do
                candidates = listClipsFromDb()
            elseif (clipActionInfo.isCustom == 1)
                candidates = clipActionInfo.clips
            else
                candidates = listLimitedNumberOfClipsFromDb(clipCount)
            endif
        else
            candidates = listLimitedNumberOfClipsFromDb(clipCount)
        endif

        setnextdialogpos(win.vscreenwidth / 2 - 400, win.vscreenheight / 2 - 200, 800, 400, "topmost")
        local eventHandle = .CustomEvent@createShowWindowEvent(inputTitle, 100, 20)
        local picked = pickstring(candidates.lines, inputTitle, 2)
        .CustomEvent@destroyShowWindowEvent(eventHandle)
        if (picked) do
            // _pickedline_ is the 1-based index of the picked line in the full (unfiltered) list
            local ids = candidates.ids
            local idx = _pickedline_ - 1
            local clipId = 0
            if (idx >= 0 && idx < ids.length)
                clipId = ids[idx]
            if (!isNumber(clipId))
                clipId = 0
            eventHandle = .CustomEvent@createShowWindowEvent(inputTitle, 100, 20)
            clipActionInfo = doActionOnClip(clipId, inputTitle)
            .CustomEvent@destroyShowWindowEvent(eventHandle)
            run = clipActionInfo.keepRun
        else
            run = 0
        endif
    endfor

    win.resetfocus(15)
endfunction

function doActionOnClip(clipId, inputTitle)
    local clipActionInfo = class.makestruct("keepRun listOption clips isCustom")
    clipActionInfo.isCustom = 0

    local keepRun = 0
    local listOption = CLIP_LIST_OPTION_LIMITED
    local action = pickstring("Preview\rShow text\rCopy\rCopy as text\rEdit\rEdit clip tags\rSave as BMP\rDelete\rSearch text\rSearch clips with tags\rList all clips with tags\rList all clips\rDelete clips without tags\rClear all clips\rKeep last clips\rList formats", inputTitle, 2)
    if (action) do
        local pproClipFile = createPProClipFileFromDb(clipId)
        switch (_pickedline_)
            case 1
                win.mouseto(win.vscreenwidth / 2, win.vscreenheight / 2)
                menu.folder(pproClipFile ++ ".*", "center")
                keepRun = 1
                break
            case 2
                // Text comes straight from the db: no clipboard round trip.
                local tmpNotePath = env("TEMP") ++ "\\tmp_show.txt"
                if (writeClipTextFromDb(clipId, tmpNotePath))
                    note.open(tmpNotePath, "", 2)
                break
            case 3
                loadClipNoCapture(pproClipFile)
                break
            case 4
                // clip.set without cap=1 is not captured.
                local copyText = readClipTextFromDb(clipId)
                if (copyText !== "" && copyText !== "(non-text)") do
                    clip.set(copyText)
                else
                    messagebox("ok information", "This clip has no text.", inputTitle)
                endif
                break
            case 5
                local tmpClipPath = makeTempBase("edit") ++ ".txt"
                if (writeClipTextFromDb(clipId, tmpClipPath)) do
                    file.runwait(0, "notepad.exe", "\"" ++ tmpClipPath ++ "\"")
                    // Build the new binary clip from the edited text, then restore the clipboard.
                    local currentData = makeTempBase("cur") ++ ".PowerProClip"
                    local hadClip = saveClipRetry(currentData)
                    clip.set(file.readall(tmpClipPath))
                    if (saveClipRetry(pproClipFile))
                        updateClipInDb(clipId, tmpClipPath, pproClipFile)
                    if (hadClip)
                        loadClipNoCapture(currentData)
                    deleteIfExists(currentData)
                endif
                deleteIfExists(tmpClipPath)
                keepRun = 1
                break
            case 6
                local clipTags = input("Edit clip tags")
                if (clipTags) do
                    updateClipTagInDb(clipId, clipTags)
                endif
                break
            case 7
                local pathToSave = inputsaveaspath
                if (pathToSave) do
                    local currentData = makeTempBase("cur") ++ ".PowerProClip"
                    local hadClip = saveClipRetry(currentData)
                    if (loadClipNoCapture(pproClipFile))
                        clip.bmptofile(pathToSave)
                    if (hadClip)
                        loadClipNoCapture(currentData)
                    deleteIfExists(currentData)
                endif
                break
            case 8
                deleteClipInDb(clipId)
                break
            case 9
                keepRun = 1
                local textToSearch = input("Search clip text")
                if (textToSearch) do
                    clipActionInfo.clips = searchClipsInDb(textToSearch)
                    clipActionInfo.isCustom = 1
                endif
                break
            case 10
                keepRun = 1
                local tagsToSearch = input("Search clips with tags")
                if (tagsToSearch) do
                    clipActionInfo.clips = searchClipsWithTagsInDb(tagsToSearch)
                    clipActionInfo.isCustom = 1
                endif
                break
            case 11
                keepRun = 1
                clipActionInfo.clips = listAllClipsWithTagsFromDb()
                clipActionInfo.isCustom = 1
                break
            case 12
                keepRun = 1
                listOption = CLIP_LIST_OPTION_ALL
                break
            case 13
                deleteClipsWithoutTagsInDb()
                break
            case 14
                deleteAllClipsInDb()
                break
            case 15
                local numClipsToKeep = input("Number of clips to keep")
                if (isNumber(numClipsToKeep) && numClipsToKeep > 0) do
                    keepLastClipsInDb(numClipsToKeep, 1)
                endif
                break
            case 16
                // Formats of the selected clip (previously listed the current clipboard instead).
                local currentData = makeTempBase("cur") ++ ".PowerProClip"
                local hadClip = saveClipRetry(currentData)
                local formats = "(clip not found)"
                if (loadClipNoCapture(pproClipFile))
                    formats = clip.ListFormats()
                if (hadClip)
                    loadClipNoCapture(currentData)
                deleteIfExists(currentData)
                messagebox("ok information", formats, "Clip format")
                break
        endswitch

        deleteIfExists(pproClipFile)
    else
        keepRun = 1
    endif

    clipActionInfo.keepRun = keepRun
    clipActionInfo.listOption = listOption
    return(clipActionInfo)
endfunction
